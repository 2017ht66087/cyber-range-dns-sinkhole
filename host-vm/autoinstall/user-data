#cloud-config
# Ubuntu 24.04 (subiquity) autoinstall for the K8S CYBER-RANGE host VM.
# Boots inside VMware Workstation (no nested virt needed - k3s runs containers
# directly). Comes up with SSH + the agent public key pre-authorized so the
# range can be driven remotely, then k3s/Docker are installed by the kit scripts.
# @@PWHASH@@ is replaced by build-seed-iso.ps1 with a SHA-512 crypt hash.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOWQbIxpYNvpw6k4W1vnNpMjSFRfU8f24MqgUKM9EiBO k8s-range-agent"
  storage:
    layout:
      name: lvm
  identity:
    hostname: k8s-range
    username: range
    password: "@@PWHASH@@"
  packages:
    - git
    - curl
    - ca-certificates
    - dnsutils
  late-commands:
    - curtin in-target --target=/target -- mkdir -p /home/range/cyber-range
    - curtin in-target --target=/target -- chown -R range:range /home/range/cyber-range
    - curtin in-target --target=/target -- bash -c "echo 'k8s-range provisioned by autoinstall' > /home/range/PROVISIONED.txt"
  user-data:
    disable_root: true
